+function matchesSearch(row: Row, pattern: string): boolean {
+  const lower = pattern.toLowerCase();
+  return [
+    row.user?.name,
+    row.username,
+    row.email,
+    ...row.teams,
+    row.member?.role,
+    row.invitedRole,
+  ]
+    .filter(Boolean)
+    .some(value => value!.toLowerCase().includes(lower));
+}
+
+type ColumnDef = {
+  id: string;
+  name: string | React.ReactNode;
+  allowsSorting: boolean;
+  minWidth?: number;
+  maxWidth?: number;
+  defaultWidth?: number;
+};
+
+function nullsLast(aPresent: boolean, bPresent: boolean): number {
+  if (aPresent === bPresent) {
+    return 0;
+  }
+  return aPresent ? -1 : 1;
+}
+
+function isPresent(row: Row, colId: string): boolean {
+  switch (colId) {
+    case 'user':
+      return !!row.user?.name;
+    case 'email':
+      return !!row.email;
+    case 'lastActiveAt': {
+      if (!row.lastActiveAt) {
+        return false;
+      }
+      const t = new Date(row.lastActiveAt).getTime();
+      return !isNaN(t);
+    }
+    case 'billingAdmin':
+      return row.member != null;
+    default:
+      return true;
+  }
+}
+
+// Ascending comparators: positive means a sorts after b.
+// Only called when both rows have present values for the column.
+const SORT_COMPARATORS: Record<string, (a: Row, b: Row) => number> = {
+  user: (a, b) =>
+    (a.user?.name ?? '').localeCompare(b.user?.name ?? '', undefined, {
+      sensitivity: 'base',
+      numeric: true,
+    }),
+  email: (a, b) =>
+    a.email.localeCompare(b.email, undefined, {
+      sensitivity: 'base',
+      numeric: true,
+    }),
+  lastActiveAt: (a, b) =>
+    new Date(a.lastActiveAt!).getTime() - new Date(b.lastActiveAt!).getTime(),
+};
+
+function sortRows(
+  rows: Row[],
+  descriptor: SortDescriptor | undefined,
+  billingUsername: string | undefined
+): Row[] {
+  if (!descriptor?.column) {
+    return rows;
+  }
+  const colId = descriptor.column as string;
+  const desc = descriptor.direction === 'descending';
+
+  if (colId === 'billingAdmin') {
+    return [...rows].sort((a, b) => {
+      const pin = nullsLast(isPresent(a, colId), isPresent(b, colId));
+      if (pin !== 0) {
+        return pin;
+      }
+      const aAdmin = a.member?.username === billingUsername ? 1 : 0;
+      const bAdmin = b.member?.username === billingUsername ? 1 : 0;
+      const cmp = aAdmin - bAdmin;
+      return desc ? -cmp : cmp;
+    });
+  }
+
+  const comparator = SORT_COMPARATORS[colId];
+  if (!comparator) {
+    return rows;
+  }
+  return [...rows].sort((a, b) => {
+    const pin = nullsLast(isPresent(a, colId), isPresent(b, colId));
+    if (pin !== 0) {
+      return pin;
+    }
+    const cmp = comparator(a, b);
+    return desc ? -cmp : cmp;
+  });
+}
