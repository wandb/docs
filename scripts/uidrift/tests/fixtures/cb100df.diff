@@ -0,0 +1,274 @@
+import {MockedProvider, type MockedResponse} from '../../test/mocks';
+import {render, screen, waitFor} from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import React from 'react';
+import {describe, expect, it, beforeEach, vi} from 'vitest';
+
+import {CloudProvider, ErrorSeverity} from '../../generated/graphql';
+import {
+  ADD_REFERENCE_BUCKET_TO_TEAM,
+  TEST_REFERENCE_BUCKET_CONNECTION,
+} from '../../graphql/teams';
+import {
+  ReferenceBucketSettings,
+  type ReferenceBucketInfo,
+} from './ReferenceBucketSettings';
+
+const toastMock = vi.hoisted(() => ({
+  success: vi.fn(),
+}));
+
+vi.mock('@wandb/components', async importOriginal => {
+  const ReactActual = await import('react');
+  const actual = await importOriginal<typeof import('@wandb/components')>();
+  const Modal = ({
+    children,
+    isOpen,
+    'data-test': dataTest,
+  }: {
+    children: React.ReactNode;
+    isOpen?: boolean;
+    'data-test'?: string;
+  }) =>
+    isOpen
+      ? ReactActual.createElement('div', {'data-test': dataTest}, children)
+      : null;
+  const Heading = ({children}: {children: React.ReactNode}) =>
+    ReactActual.createElement('h2', null, children);
+  const Content = ({children}: {children: React.ReactNode}) =>
+    ReactActual.createElement('div', null, children);
+  const Footer = ({children}: {children: React.ReactNode}) =>
+    ReactActual.createElement('div', null, children);
+
+  return {
+    ...actual,
+    Dialog: {...actual.Dialog, Modal, Heading, Content, Footer},
+    toast: toastMock,
+  };
+});
+
+const referenceBucket: ReferenceBucketInfo = {
+  ID: 'bucket-store-1',
+  provider: CloudProvider.Aws,
+  name: 'ref-bucket',
+  path: 'team-a',
+};
+
+const testInput = {
+  bucket: {
+    provider: CloudProvider.Aws,
+    name: 'ref-bucket',
+    path: null,
+    organizationID: 'org-1',
+  },
+  objectKey: 'probe/owned.txt',
+};
+
+const addInput = {
+  entityID: 'entity-1',
+  ...testInput,
+};
+
+const renderReferenceBucketSettings = ({
+  referenceBuckets = [],
+  canManage = true,
+  mocks = [],
+  onChanged = vi.fn().mockResolvedValue(undefined),
+}: {
+  referenceBuckets?: ReferenceBucketInfo[];
+  canManage?: boolean;
+  mocks?: MockedResponse[];
+  onChanged?: ReturnType<typeof vi.fn>;
+} = {}) => {
+  render(
+    <MockedProvider mocks={mocks} addTypename={false}>
+      <ReferenceBucketSettings
+        entityID="entity-1"
+        organizationID="org-1"
+        referenceBuckets={referenceBuckets}
+        canManage={canManage}
+        onChanged={onChanged}
+      />
+    </MockedProvider>
+  );
+  return {onChanged};
+};
+
+const queryByDataTest = (name: string) =>
+  document.querySelector(`[data-test="${name}"]`);
+
+const getByDataTest = (name: string) => {
+  const element = queryByDataTest(name);
+  if (element == null) {
+    throw new Error(`Unable to find data-test="${name}"`);
+  }
+  return element as HTMLElement;
+};
+
+const openAndFillModal = async () => {
+  const user = userEvent.setup();
+  await user.click(getByDataTest('reference-bucket-add-button'));
+  await user.type(screen.getByLabelText('Bucket name'), 'ref-bucket');
+  await user.type(screen.getByLabelText('Probe object key'), 'probe/owned.txt');
+  return user;
+};
+
+describe('ReferenceBucketSettings', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it('shows an empty state and add control for managers', () => {
+    renderReferenceBucketSettings();
+
+    expect(getByDataTest('reference-bucket-settings')).toBeInTheDocument();
+    expect(getByDataTest('reference-bucket-empty')).toHaveTextContent(
+      'No reference buckets configured.'
+    );
+    expect(getByDataTest('reference-bucket-add-button')).toBeInTheDocument();
+  });
+
+  it('shows placeholders without a path field in the add dialog', async () => {
+    const user = userEvent.setup();
+    renderReferenceBucketSettings();
+
+    await user.click(getByDataTest('reference-bucket-add-button'));
+
+    expect(screen.getByLabelText('Bucket name')).toHaveAttribute(
+      'placeholder',
+      'my-reference-bucket'
+    );
+    expect(screen.getByLabelText('Probe object key')).toHaveAttribute(
+      'placeholder',
+      'team-a/probe/owned.txt'
+    );
+    expect(screen.queryByLabelText('Path')).not.toBeInTheDocument();
+    expect(queryByDataTest('reference-bucket-path')).toBeNull();
+    expect(
+      screen.getByText(
+        'Enter only the bucket name. Do not include a URL scheme such as s3:// or gs://.'
+      )
+    ).toBeInTheDocument();
+    expect(
+      screen.getByText(
+        'Enter the key of an existing object inside the bucket. Do not include the bucket name or a URL scheme.'
+      )
+    ).toBeInTheDocument();
+  });
+
+  it('renders existing buckets without add controls for non-managers', () => {
+    renderReferenceBucketSettings({
+      referenceBuckets: [referenceBucket],
+      canManage: false,
+    });
+
+    expect(queryByDataTest('reference-bucket-add-button')).toBeNull();
+    expect(getByDataTest('reference-bucket-table')).toBeInTheDocument();
+    expect(screen.getByText('ref-bucket')).toBeInTheDocument();
+    expect(screen.getByText('team-a')).toBeInTheDocument();
+    expect(screen.queryByText('KMS key ID')).not.toBeInTheDocument();
+    expect(screen.queryByText('AWS external ID')).not.toBeInTheDocument();
+  });
+
+  it('clicking Add tests the current input before adding the bucket', async () => {
+    const onChanged = vi.fn().mockResolvedValue(undefined);
+    renderReferenceBucketSettings({
+      onChanged,
+      mocks: [
+        {
+          request: {
+            query: TEST_REFERENCE_BUCKET_CONNECTION,
+            variables: {input: testInput},
+          },
+          result: {data: {testReferenceBucketConnection: []}},
+        },
+        {
+          request: {
+            query: ADD_REFERENCE_BUCKET_TO_TEAM,
+            variables: {input: addInput},
+          },
+          result: {
+            data: {
+              addReferenceBucketToTeam: {
+                success: true,
+                bucketStoreID: 'bucket-store-2',
+                entity: {id: 'entity-1', name: 'team-a'},
+                clientMutationID: null,
+              },
+            },
+          },
+        },
+      ],
+    });
+
+    const user = await openAndFillModal();
+    await user.click(getByDataTest('reference-bucket-submit-button'));
+
+    await waitFor(() => expect(onChanged).toHaveBeenCalledTimes(1));
+    expect(toastMock.success).toHaveBeenCalledWith('Reference bucket added.');
+  });
+
+  it('does not add when the connection test returns errors', async () => {
+    const onChanged = vi.fn().mockResolvedValue(undefined);
+    renderReferenceBucketSettings({
+      onChanged,
+      mocks: [
+        {
+          request: {
+            query: TEST_REFERENCE_BUCKET_CONNECTION,
+            variables: {input: testInput},
+          },
+          result: {
+            data: {
+              testReferenceBucketConnection: [
+                {
+                  message: 'Cannot read probe object.',
+                  severity: ErrorSeverity.Error,
+                },
+              ],
+            },
+          },
+        },
+      ],
+    });
+
+    const user = await openAndFillModal();
+    await user.click(getByDataTest('reference-bucket-submit-button'));
+
+    await waitFor(() =>
+      expect(screen.getByText('Cannot read probe object.')).toBeInTheDocument()
+    );
+    expect(onChanged).not.toHaveBeenCalled();
+    expect(toastMock.success).not.toHaveBeenCalled();
+  });
+
+  it('stops Add when its connection-test input changes in flight', async () => {
+    const onChanged = vi.fn().mockResolvedValue(undefined);
+    renderReferenceBucketSettings({
+      onChanged,
+      mocks: [
+        {
+          request: {
+            query: TEST_REFERENCE_BUCKET_CONNECTION,
+            variables: {input: testInput},
+          },
+          delay: 30,
+          result: {data: {testReferenceBucketConnection: []}},
+        },
+      ],
+    });
+
+    const user = await openAndFillModal();
+    await user.click(getByDataTest('reference-bucket-submit-button'));
+    expect(screen.getByText('Testing connection...')).toBeInTheDocument();
+
+    await user.clear(screen.getByLabelText('Bucket name'));
+    await user.type(screen.getByLabelText('Bucket name'), 'another-bucket');
+
+    await new Promise(resolve => setTimeout(resolve, 50));
+    expect(queryByDataTest('reference-bucket-connection-status')).toBeNull();
+    expect(queryByDataTest('reference-bucket-submit-error')).toBeNull();
+    expect(onChanged).not.toHaveBeenCalled();
+    expect(toastMock.success).not.toHaveBeenCalled();
+  });
+});
