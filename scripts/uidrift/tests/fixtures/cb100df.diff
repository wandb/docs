+import {
+  Banner,
+  Button as DesignSystemButton,
+  Dialog,
+  TextField,
+  toast,
+} from '@wandb/components';
+import {Button} from '@wandb/weave/components/Button';
+import {TailwindContents} from '@wandb/weave/components/Tailwind';
+import React, {useRef, useState} from 'react';
+import {Segment, Table} from 'semantic-ui-react';
+
+import {cloudProviderValuesToDisplayNames} from '../../components/CreateTeam/hooks';
+import {
+  CloudProvider,
+  ErrorSeverity,
+  type StorageBucketInfo,
+  type StorageBucketInfoInput,
+  type TestReferenceBucketConnectionInput,
+  useAddReferenceBucketToTeamMutation,
+  useTestReferenceBucketConnectionMutation,
+} from '../../generated/graphql';
+import {
+  extractErrorMessageFromApolloError,
+  propagateErrorsContext,
+} from '../../util/errors';
+import * as S from './ReferenceBucketSettings.styles';
+import * as TeamSettingsS from './TeamSettings.styles';
+
+// The subset of StorageBucketInfo selected by the referenceBucketInfos query
+// field (see ENTITY_QUERY). KMS/AWS external-ID fields are intentionally omitted.
+export type ReferenceBucketInfo = Pick<
+  StorageBucketInfo,
+  'ID' | 'provider' | 'name' | 'path'
+>;
+
+type ConnectionMessage = {
+  message: string;
+  severity: ErrorSeverity;
+};
+
+type ConnectionState =
+  | {state: 'idle'}
+  | {state: 'loading'}
+  | {
+      state: 'invalid';
+      errors: ConnectionMessage[];
+      warnings: ConnectionMessage[];
+    }
+  | {state: 'valid'; warnings: ConnectionMessage[]};
+
+type Props = {
+  entityID: string;
+  organizationID: string | null;
+  referenceBuckets: ReferenceBucketInfo[];
+  canManage: boolean;
+  onChanged: () => Promise<unknown>;
+};
+
+const referenceProviderOptions = [CloudProvider.Aws, CloudProvider.Gcp];
+
+const displayValue = (value?: string | null) => value || '-';
+
+export const ReferenceBucketSettings = ({
+  entityID,
+  organizationID,
+  referenceBuckets,
+  canManage,
+  onChanged,
+}: Props) => {
+  const [isModalOpen, setIsModalOpen] = useState(false);
+  const [provider, setProvider] = useState<CloudProvider>(CloudProvider.Aws);
+  const [bucketName, setBucketName] = useState('');
+  const [objectKey, setObjectKey] = useState('');
+  const [connectionState, setConnectionState] = useState<ConnectionState>({
+    state: 'idle',
+  });
+  const [testedFingerprint, setTestedFingerprint] = useState<string | null>(
+    null
+  );
+  const [serverError, setServerError] = useState<string | null>(null);
+  const validationGeneration = useRef(0);
+
+  const [testReferenceBucketConnection, {loading: testLoading}] =
+    useTestReferenceBucketConnectionMutation();
+  const [addReferenceBucketToTeam, {loading: addLoading}] =
+    useAddReferenceBucketToTeamMutation();
+
+  const resetConnectionState = () => {
+    validationGeneration.current += 1;
+    setConnectionState({state: 'idle'});
+    setTestedFingerprint(null);
+    setServerError(null);
+  };
+
+  const closeModal = () => {
+    setIsModalOpen(false);
+    setProvider(CloudProvider.Aws);
+    setBucketName('');
+    setObjectKey('');
+    resetConnectionState();
+  };
+
+  // KMS and AWS external-ID configuration has not been tested end-to-end for
+  // reference buckets, so this UI intentionally does not imply it is supported.
+  const buildBucketInput = (): StorageBucketInfoInput => ({
+    provider,
+    name: bucketName.trim(),
+    path: null,
+    organizationID,
+  });
+
+  const buildReferenceInput = (): TestReferenceBucketConnectionInput => ({
+    bucket: buildBucketInput(),
+    objectKey: objectKey.trim(),
+  });
+
+  const fingerprint = JSON.stringify(buildReferenceInput());
+
+  const requiredFieldsPresent =
+    bucketName.trim() !== '' && objectKey.trim() !== '';
+  const canSubmit =
+    canManage && requiredFieldsPresent && !testLoading && !addLoading;
+
+  const testConnection = async (): Promise<boolean> => {
+    const currentValidationGeneration = ++validationGeneration.current;
+    setConnectionState({state: 'loading'});
+    setServerError(null);
+
+    try {
+      const {data} = await testReferenceBucketConnection({
+        variables: {input: buildReferenceInput()},
+        context: propagateErrorsContext(),
+      });
+
+      if (validationGeneration.current !== currentValidationGeneration) {
+        return false;
+      }
+
+      const messages = data?.testReferenceBucketConnection ?? [];
+      const errors = messages.filter(
+        message => message.severity === ErrorSeverity.Error
+      );
+      const warnings = messages.filter(
+        message => message.severity === ErrorSeverity.Warn
+      );
+
+      if (errors.length > 0) {
+        setConnectionState({state: 'invalid', errors, warnings});
+        setTestedFingerprint(null);
+        return false;
+      }
+
+      setConnectionState({state: 'valid', warnings});
+      setTestedFingerprint(fingerprint);
+      return true;
+    } catch (e) {
+      if (validationGeneration.current !== currentValidationGeneration) {
+        return false;
+      }
+
+      const message = extractErrorMessageFromApolloError(e) ?? `${e}`;
+      setConnectionState({
+        state: 'invalid',
+        errors: [{message, severity: ErrorSeverity.Error}],
+        warnings: [],
+      });
+      setTestedFingerprint(null);
+      return false;
+    }
+  };
+
+  const handleAdd = async () => {
+    if (!canSubmit) {
+      return;
+    }
+
+    if (
+      testedFingerprint !== fingerprint ||
+      connectionState.state !== 'valid'
+    ) {
+      const ok = await testConnection();
+      if (!ok) {
+        return;
+      }
+    }
+
+    setServerError(null);
+    try {
+      await addReferenceBucketToTeam({
+        variables: {
+          input: {
+            entityID,
+            ...buildReferenceInput(),
+          },
+        },
+        context: propagateErrorsContext(),
+      });
+    } catch (e) {
+      setServerError(extractErrorMessageFromApolloError(e) ?? `${e}`);
+      return;
+    }
+
+    // The bucket was added; commit to the success path regardless of whether
+    // the follow-up refetch succeeds, so a transient refetch failure is not
+    // surfaced as an add failure or left in a stuck-open modal.
+    toast.success('Reference bucket added.');
+    closeModal();
+    await onChanged();
+  };
+
+  const renderMessageList = (
+    messages: ConnectionMessage[],
+    variant: 'error' | 'warning'
+  ) => (
+    <Banner
+      aria-label="Connection test status"
+      data-test="reference-bucket-connection-status"
+      isDismissible={false}
+      variant={variant}>
+      <Banner.Body>
+        <ul>
+          {messages.map(message => (
+            <li key={message.message}>{message.message}</li>
+          ))}
+        </ul>
+      </Banner.Body>
+    </Banner>
+  );
+
+  const statusMessage = () => {
+    if (connectionState.state === 'loading') {
+      return (
+        <Banner
+          aria-label="Connection test status"
+          data-test="reference-bucket-connection-status"
+          isDismissible={false}
+          variant="info">
+          <Banner.Body>Testing connection...</Banner.Body>
+        </Banner>
+      );
+    }
+
+    if (connectionState.state === 'invalid') {
+      return renderMessageList(connectionState.errors, 'error');
+    }
+
+    if (connectionState.state === 'valid') {
+      if (connectionState.warnings.length > 0) {
+        return renderMessageList(connectionState.warnings, 'warning');
+      }
+
+      return (
+        <Banner
+          aria-label="Connection test status"
+          data-test="reference-bucket-connection-status"
+          isDismissible={false}
+          variant="success">
+          <Banner.Body>Connection test passed.</Banner.Body>
+        </Banner>
+      );
+    }
+
+    return null;
+  };
+
+  return (
+    <Segment data-test="reference-bucket-settings">
+      <S.HeaderRow>
+        <S.HeaderText>
+          <TeamSettingsS.SectionHeader smallMargin>
+            Reference buckets
+          </TeamSettingsS.SectionHeader>
+          <TeamSettingsS.SectionSubheader smallMargin>
+            External object storage for Weave references.
+          </TeamSettingsS.SectionSubheader>
+        </S.HeaderText>
+        {canManage && (
+          <Button
+            data-test="reference-bucket-add-button"
+            icon="add-new"
+            onClick={() => setIsModalOpen(true)}
+            size="small">
+            Add bucket
+          </Button>
+        )}
+      </S.HeaderRow>
+
+      {referenceBuckets.length === 0 ? (
+        <S.EmptyState data-test="reference-bucket-empty">
+          No reference buckets configured.
+        </S.EmptyState>
+      ) : (
+        <Table data-test="reference-bucket-table" basic="very">
+          <Table.Header>
+            <Table.Row>
+              <Table.HeaderCell>Cloud Provider</Table.HeaderCell>
+              <Table.HeaderCell>Bucket name</Table.HeaderCell>
+              <Table.HeaderCell>Path</Table.HeaderCell>
+            </Table.Row>
+          </Table.Header>
+          <Table.Body>
+            {referenceBuckets.map(bucket => (
+              <Table.Row data-test="reference-bucket-row" key={bucket.ID}>
+                <Table.Cell>
+                  {cloudProviderValuesToDisplayNames[bucket.provider]}
+                </Table.Cell>
+                <Table.Cell>{bucket.name}</Table.Cell>
+                <Table.Cell>{displayValue(bucket.path)}</Table.Cell>
+              </Table.Row>
+            ))}
+          </Table.Body>
+        </Table>
+      )}
+
+      <Dialog.Modal
+        data-test="reference-bucket-add-modal"
+        isOpen={isModalOpen}
+        onOpenChange={open => {
+          if (!open) {
+            closeModal();
+          }
+        }}>
+        <Dialog.Heading>Add reference bucket</Dialog.Heading>
+        <Dialog.Content>
+          <TailwindContents>
+            <div className="flex flex-col gap-16 text-moon-800 dark:text-moon-200">
+              <div className="flex flex-col gap-6">
+                <label
+                  className="text-sm font-semibold"
+                  htmlFor="reference-bucket-provider">
+                  Provider
+                </label>
+                <select
+                  className="h-40 w-full rounded-md border border-moon-250 bg-white px-12 text-base text-moon-800 outline-none hover:border-teal-350 focus:border-teal-450 dark:border-moon-700 dark:bg-moon-900 dark:text-moon-200 dark:hover:border-teal-650 dark:focus:border-teal-550"
+                  data-test="reference-bucket-provider"
+                  id="reference-bucket-provider"
+                  value={provider}
+                  onChange={event => {
+                    const nextProvider = event.target.value as CloudProvider;
+                    setProvider(nextProvider);
+                    resetConnectionState();
+                  }}>
+                  {referenceProviderOptions.map(option => (
+                    <option key={option} value={option}>
+                      {cloudProviderValuesToDisplayNames[option]}
+                    </option>
+                  ))}
+                </select>
+              </div>
+
+              <TextField
+                data-test="reference-bucket-name"
+                description="Enter only the bucket name. Do not include a URL scheme such as s3:// or gs://."
+                fullWidth
+                label="Bucket name"
+                value={bucketName}
+                onChange={value => {
+                  setBucketName(value);
+                  resetConnectionState();
+                }}
+                placeholder="my-reference-bucket"
+              />
+
+              <TextField
+                data-test="reference-bucket-object-key"
+                description="Enter the key of an existing object inside the bucket. Do not include the bucket name or a URL scheme."
+                fullWidth
+                label="Probe object key"
+                placeholder="team-a/probe/owned.txt"
+                value={objectKey}
+                onChange={value => {
+                  setObjectKey(value);
+                  resetConnectionState();
+                }}
+              />
+
+              {statusMessage()}
+              {serverError && (
+                <Banner
+                  data-test="reference-bucket-submit-error"
+                  isDismissible={false}
+                  variant="error">
+                  <Banner.Body>{serverError}</Banner.Body>
+                </Banner>
+              )}
+            </div>
+          </TailwindContents>
+        </Dialog.Content>
+        <Dialog.Footer>
+          <DesignSystemButton variant="secondary" onPress={closeModal}>
+            Cancel
+          </DesignSystemButton>
+          <DesignSystemButton
+            data-test="reference-bucket-test-button"
+            isDisabled={!requiredFieldsPresent || testLoading || addLoading}
+            isPending={testLoading}
+            isPendingAriaLabel="Testing connection"
+            onPress={testConnection}
+            variant="secondary">
+            Test connection
+          </DesignSystemButton>
+          <DesignSystemButton
+            data-test="reference-bucket-submit-button"
+            isDisabled={!canSubmit}
+            isPending={addLoading}
+            isPendingAriaLabel="Adding reference bucket"
+            onPress={handleAdd}>
+            Add bucket
+          </DesignSystemButton>
+        </Dialog.Footer>
+      </Dialog.Modal>
+    </Segment>
+  );
+};
